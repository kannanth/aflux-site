---
import Base from "../layouts/Base.astro";
---
<Base title="Download AfLux">
  <style>
    .dl-page { max-width: 700px; margin: 0 auto; padding: 4rem 2rem; }
    .dl-page h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
    .dl-page .subtitle { color: #525252; margin-bottom: 2.5rem; }
    .dl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
    .dl-card { background: white; border: 1px solid #e5e5e5; border-radius: 0.75rem; padding: 2rem; text-align: center; }
    .dl-card h2 { font-size: 1.125rem; font-weight: 600; margin-bottom: 0.25rem; }
    .dl-card p { font-size: 0.8rem; color: #737373; margin-bottom: 1.25rem; }
    .dl-card .btn { display: inline-block; background: #171717; color: white; padding: 0.6rem 1.5rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 600; text-decoration: none; }
    .dl-card .btn:hover { background: #404040; text-decoration: none; }
    .req { background: #f5f5f5; border-radius: 0.5rem; padding: 1.5rem; font-size: 0.8rem; color: #525252; margin-bottom: 1.5rem; }
    .req h3 { font-size: 0.875rem; font-weight: 600; color: #171717; margin-bottom: 0.5rem; }
    .req ul { padding-left: 1.25rem; }
    .req li { margin-bottom: 0.25rem; }
    .install-note { border-radius: 0.5rem; padding: 1.5rem; font-size: 0.8rem; margin-bottom: 1.5rem; }
    .install-note h3 { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; }
    .install-note code { background: #e5e5e5; padding: 0.15rem 0.4rem; border-radius: 0.25rem; font-size: 0.75rem; }
    .install-note ol { padding-left: 1.25rem; }
    .install-note li { margin-bottom: 0.4rem; }
    .mac-note { background: #fefce8; border: 1px solid #fde68a; color: #713f12; }
    .win-note { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e3a5f; }
  </style>

  <div class="dl-page">
    <h1>Download AfLux</h1>
    <p class="subtitle">Free. No account required. Your data never leaves your device.</p>

    <div class="dl-grid">
      <div class="dl-card">
        <h2>macOS</h2>
        <p>Apple Silicon &amp; Intel<br/>macOS 12+</p>
        <a href="https://github.com/kannanth/aflux-site/releases/latest/download/AfLux_0.1.0_aarch64.dmg" class="btn">Download .dmg</a>
      </div>
      <div class="dl-card">
        <h2>Windows</h2>
        <p>Windows 10/11<br/>x64</p>
        <a href="https://github.com/kannanth/aflux-site/releases/latest/download/AfLux-windows-msi.zip" class="btn">Download .msi</a>
      </div>
    </div>

    <div class="install-note win-note">
      <h3>Windows: First-time setup</h3>
      <ol>
        <li>If you see "Windows protected your PC" — click <strong>"More info"</strong> → <strong>"Run anyway"</strong></li>
        <li>If you see "MSVCP140_1.dll not found" — install the <a href="https://aka.ms/vs/17/release/vc_redist.x64.exe">Microsoft Visual C++ Redistributable</a> (free, one-time)</li>
      </ol>
    </div>

    <div class="req">
      <h3>Requirements</h3>
      <ul>
        <li><strong>Disk space</strong> — ~200 MB for the app. The AI model (~2.3 GB) downloads automatically on first launch.</li>
        <li><strong>No internet required</strong> after initial setup. Everything runs locally on your device.</li>
        <li><strong>No external software needed</strong> — the AI engine is built into the app.</li>
      </ul>
    </div>
  </div>
</Base>
