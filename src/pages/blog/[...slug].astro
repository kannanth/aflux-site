---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — AfLux Blog`}>
  <style>
    .post { max-width: 700px; margin: 0 auto; padding: 4rem 2rem; }
    .post h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
    .post .meta { font-size: 0.8rem; color: #737373; margin-bottom: 2rem; }
    .post .content { font-size: 0.95rem; line-height: 1.8; }
    .post .content h2 { font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; }
    .post .content p { margin-bottom: 1rem; }
    .post .content ul { padding-left: 1.25rem; margin-bottom: 1rem; }
    .post .content li { margin-bottom: 0.3rem; }
    .back { display: inline-block; margin-bottom: 1.5rem; font-size: 0.8rem; }
  </style>

  <div class="post">
    <a href="/blog" class="back">&larr; Back to blog</a>
    <h1>{post.data.title}</h1>
    <div class="meta">{new Date(post.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</div>
    <div class="content">
      <Content />
    </div>
  </div>
</Base>
