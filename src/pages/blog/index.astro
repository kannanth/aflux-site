---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---
<Base title="Blog — AfLux">
  <style>
    .page { max-width: 700px; margin: 0 auto; padding: 4rem 2rem; }
    .page h1 { font-size: 2rem; font-weight: 700; margin-bottom: 2rem; }
    .post-list { list-style: none; }
    .post-item { border-bottom: 1px solid #e5e5e5; padding: 1.25rem 0; }
    .post-item:last-child { border-bottom: none; }
    .post-item a { font-size: 1.1rem; font-weight: 600; color: #171717; }
    .post-item a:hover { color: #2563eb; }
    .post-meta { font-size: 0.8rem; color: #737373; margin-top: 0.25rem; }
    .post-excerpt { font-size: 0.875rem; color: #525252; margin-top: 0.5rem; }
  </style>

  <div class="page">
    <h1>Blog</h1>
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <div class="post-meta">{new Date(post.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</div>
          {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
        </li>
      ))}
    </ul>
  </div>
</Base>
